{
  "components" : {
    "schemas" : {
      "GroupMemberSummary" : {
        "properties" : {
          "memberId" : {
            "pattern" : "^[a-z0-9]{10}$",
            "type" : "string"
          },
          "permission" : {
            "description" : "권한 code: Viewer, Editor, Admin",
            "type" : "string"
          }
        },
        "required" : [ "memberId", "permission" ],
        "type" : "object"
      },
      "GroupProblemResponse" : {
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "example" : "about:blank",
            "type" : "string"
          }
        },
        "required" : [ "code", "detail", "instance", "status", "title", "type" ],
        "type" : "object"
      },
      "GroupSummaryItem" : {
        "properties" : {
          "groupId" : {
            "pattern" : "^[a-z0-9]{10}$",
            "type" : "string"
          },
          "groupName" : {
            "minLength" : 1,
            "type" : "string"
          },
          "members" : {
            "items" : {
              "$ref" : "#/components/schemas/GroupMemberSummary"
            },
            "type" : "array"
          },
          "totalMemberCount" : {
            "description" : "그룹 전체 소속 인원",
            "format" : "int64",
            "minimum" : 0,
            "type" : "integer"
          }
        },
        "required" : [ "groupId", "groupName", "members", "totalMemberCount" ],
        "type" : "object"
      },
      "GroupSummaryResponse" : {
        "properties" : {
          "group" : {
            "items" : {
              "$ref" : "#/components/schemas/GroupSummaryItem"
            },
            "type" : "array"
          }
        },
        "required" : [ "group" ],
        "type" : "object"
      },
      "MemberGroupDetailResponse" : {
        "properties" : {
          "groupId" : {
            "pattern" : "^[a-z0-9]{10}$",
            "type" : "string"
          },
          "groupName" : {
            "minLength" : 1,
            "type" : "string"
          },
          "memberId" : {
            "pattern" : "^[a-z0-9]{10}$",
            "type" : "string"
          },
          "permission" : {
            "description" : "권한 code: Viewer, Editor, Admin",
            "type" : "string"
          },
          "pricing" : {
            "description" : "과금 code: Free, Advanced, Premium",
            "type" : "string"
          },
          "registeredDate" : {
            "description" : "그룹 가입 시각. 한국 시간(Asia/Seoul), 분 단위",
            "example" : "2026-08-15 13:00",
            "maxLength" : 16,
            "minLength" : 16,
            "pattern" : "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$",
            "type" : "string"
          }
        },
        "required" : [ "groupId", "groupName", "memberId", "permission", "pricing", "registeredDate" ],
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "internalServiceId" : {
        "in" : "header",
        "name" : "X-Internal-Service-Id",
        "type" : "apiKey"
      },
      "internalServiceKey" : {
        "in" : "header",
        "name" : "X-Internal-Service-Key",
        "type" : "apiKey"
      }
    }
  },
  "info" : {
    "description" : "내부 전용 그룹 API. 멤버 서버가 공유 시크릿 헤더를 추가해 호출합니다.",
    "title" : "그룹 서비스 API",
    "version" : "0.1.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/group/{memberId}" : {
      "get" : {
        "description" : "미소속 404, 다건 500. 시각은 한국 시간 yyyy-MM-dd HH:mm입니다.",
        "operationId" : "getMemberGroupDetail",
        "parameters" : [ {
          "in" : "path",
          "name" : "memberId",
          "required" : true,
          "schema" : {
            "pattern" : "^[a-z0-9]{10}$",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MemberGroupDetailResponse"
                }
              }
            },
            "description" : "단일 소속 상세"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/GroupProblemResponse"
                }
              }
            },
            "description" : "VALIDATION_FAILED"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/GroupProblemResponse"
                }
              }
            },
            "description" : "INTERNAL_ACCESS_DENIED"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/GroupProblemResponse"
                }
              }
            },
            "description" : "GROUP_MEMBERSHIP_NOT_FOUND"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/GroupProblemResponse"
                }
              }
            },
            "description" : "INTERNAL_ERROR 또는 GROUP_MEMBERSHIP_AMBIGUOUS"
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/GroupProblemResponse"
                }
              }
            },
            "description" : "SERVICE_UNAVAILABLE"
          }
        },
        "summary" : "멤버의 단일 그룹 상세",
        "tags" : [ "group-query-controller" ]
      }
    },
    "/api/groups/summary" : {
      "get" : {
        "description" : "members는 요청 멤버만, totalMemberCount는 그룹 전체 인원입니다.",
        "operationId" : "getGroupSummaries",
        "parameters" : [ {
          "explode" : true,
          "in" : "query",
          "name" : "memberIds",
          "required" : true,
          "schema" : {
            "items" : {
              "pattern" : "^[a-z0-9]{10}$",
              "type" : "string"
            },
            "maxItems" : 100,
            "minItems" : 1,
            "type" : "array",
            "uniqueItems" : true
          },
          "style" : "form"
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/GroupSummaryResponse"
                }
              }
            },
            "description" : "그룹별 요약"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/GroupProblemResponse"
                }
              }
            },
            "description" : "VALIDATION_FAILED"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/GroupProblemResponse"
                }
              }
            },
            "description" : "INTERNAL_ACCESS_DENIED"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/GroupProblemResponse"
                }
              }
            },
            "description" : "INTERNAL_ERROR 또는 GROUP_MEMBERSHIP_AMBIGUOUS"
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/GroupProblemResponse"
                }
              }
            },
            "description" : "SERVICE_UNAVAILABLE"
          }
        },
        "summary" : "멤버 ID 목록의 그룹 요약",
        "tags" : [ "group-query-controller" ]
      }
    }
  },
  "security" : [ {
    "internalServiceId" : [ ],
    "internalServiceKey" : [ ]
  } ],
  "servers" : [ {
    "description" : "Generated server url",
    "url" : "/"
  } ]
}
