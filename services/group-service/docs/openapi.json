            "format" : "int64",
            "minimum" : 0,
            "type" : "integer"
          }
        },
        "required" : [ "groupId", "groupName", "members", "totalMemberCount" ],
        "type" : "object"
      },
      "GroupSummaryResponse" : {
        "additionalProperties" : false,
        "properties" : {
          "group" : {
            "items" : {
              "$ref" : "#/components/schemas/GroupSummaryItem"
