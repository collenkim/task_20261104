#!/bin/sh
# AI 세션 로깅 pre-push hook: 실제로 push하는 커밋(OID)을 검사한다(읽기 전용).
# master: 로그 완전성(원본 끝까지), 커밋된 비밀값, 커밋 메시지·로그 경로. 그 밖의 브랜치: 메시지·로그 경로.
ROOT=$(git rev-parse --show-toplevel) || exit 1
HOOKDIR=$(cd "$(dirname "$0")" && pwd)
CLI="$ROOT/scripts/ai_logging/cli.py"
[ -f "$CLI" ] || CLI="$HOOKDIR/../ai_logging/cli.py"
for PY in python3 python py; do
  if command -v "$PY" >/dev/null 2>&1 && "$PY" -I -c "import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)" >/dev/null 2>&1; then
    AI_LOGGING_ROOT="$ROOT" exec "$PY" -I "$CLI" githook pre-push "$@"
  fi
done
echo "[AI 세션 로깅] Python 3.11 이상을 찾지 못해 push를 막았습니다." >&2
exit 1
